{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",                    // allows ormconfig.ts at project root
    "outDir": "dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,

    "experimentalDecorators": true,    // <-- REQUIRED for TypeORM decorators
    "emitDecoratorMetadata": true,     // <-- REQUIRED for TypeORM decorators
    "strictPropertyInitialization": false
  },
  "include": ["src", "ormconfig.ts"]
}



